NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for the new AI-matching sessions system (src/lib/sessionDb.ts,
# src/app/api/sessions/**). Server-only — never prefix with NEXT_PUBLIC_.
# Get it from Supabase: Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Required — the AI matching call in src/lib/gemini.ts (Gemini API).
GEMINI_API_KEY=

# (Legacy) Optional — powered the one-line AI summary on the old rule-based
# results page (src/lib/summary.ts). Not used by the new sessions system.
# GEMINI_API_KEY above is now the primary Gemini env var.
